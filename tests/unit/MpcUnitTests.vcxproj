  <ItemDefinitionGroup>
    <!-- Only global properties reach a referenced project. -->
    <ProjectReference>
      <AdditionalProperties>SolutionDir=$(SolutionDir)</AdditionalProperties>
    </ProjectReference>
  </ItemDefinitionGroup>
  <ItemGroup>
