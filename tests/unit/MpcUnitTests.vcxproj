      <PreprocessorDefinitions>_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalLibraryDirectories>$(SolutionDir)bin\lib\$(Configuration)_$(PlatformName);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>strmiids.lib;Uuid.lib;Version.lib;Vfw32.lib;Winmm.lib;Shlwapi.lib;dxguid.lib;d3d9.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SetChecksum>false</SetChecksum>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
