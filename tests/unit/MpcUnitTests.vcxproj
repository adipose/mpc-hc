  <PropertyGroup Label="Globals">
    <ProjectGuid>{6D0E1C0B-6C0F-4E0E-9A43-5B1D0A7C3F21}</ProjectGuid>
    <RootNamespace>MpcUnitTests</RootNamespace>
    <Keyword>MFCProj</Keyword>
    <ProjectName>MpcUnitTests</ProjectName>
    <!-- Not part of mpc-hc.sln. common.props derives IntDir/OutDir from
         SolutionDir, so point it at the repository root; the referenced
         projects inherit it and their libs land where a solution build
         puts them (bin\lib\<cfg>_x64). -->
    <SolutionDir Condition="'$(SolutionDir)'=='' Or '$(SolutionDir)'=='*Undefined*'">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</SolutionDir>
    <!-- libass.vcxproj merges freetype2/fribidi/harfbuzz/iconv/zlib/unibreak
         into its lib but names them only as solution-level dependencies.
         Without the solution the order has to come from here: references
         build one at a time, in the order listed below. -->
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="..\..\src\platform.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
