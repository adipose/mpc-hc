msgctxt "IDS_PPAGE_CAPTURE_FG0"
msgid "Never"
msgstr "ਕਦੇ ਨਹੀਂ"

msgctxt "IDS_PPAGE_CAPTURE_FG1"
msgid "Only when switching different video types"
msgstr "ਸਿਰਫ਼ ਜਦੋਂ ਵੱਖ-ਵੱਖ ਵੀਡੀਓ ਕਿਸਮਾਂ ਵਿਚਕਾਰ ਬਦਲਿਆ ਜਾਵੇ"

msgctxt "IDS_PPAGE_CAPTURE_FG2"
msgid "Always (default)"
msgstr "ਹਮੇਸ਼ਾਂ (ਮੂਲ-ਸੈਟਿੰਗ)"

msgctxt "IDS_PPAGE_CAPTURE_FGDESC0"
msgid ""
"Not supported by some devices. Two video decoders always present in the "
"filter graph."
msgstr ""
"ਕੁਝ ਡਿਵਾਈਸਾਂ ਵੱਲੋਂ ਸਮਰਥਿਤ ਨਹੀਂ। ਫਿਲਟਰ ਗ੍ਰਾਫ ਵਿੱਚ ਹਮੇਸ਼ਾਂ ਦੋ ਵੀਡੀਓ ਡੀਕੋਡਰ "
"ਮੌਜੂਦ ਰਹਿੰਦੇ ਹਨ।"

msgctxt "IDS_PPAGE_CAPTURE_FGDESC1"
msgid ""
"Fast except when switching between different video streams. Only one video "
"decoder present in the filter graph."
msgstr ""
"ਤੇਜ਼, ਸਿਵਾਏ ਜਦੋਂ ਵੱਖ-ਵੱਖ ਵੀਡੀਓ streams ਵਿਚਕਾਰ ਬਦਲਿਆ ਜਾਵੇ। ਫਿਲਟਰ ਗ੍ਰਾਫ ਵਿੱਚ "
"ਸਿਰਫ਼ ਇੱਕ ਵੀਡੀਓ ਡੀਕੋਡਰ ਮੌਜੂਦ ਹੈ।"

msgctxt "IDS_PPAGE_CAPTURE_SFG0"
msgid "Never if possible (fastest, but not supported by most filters)"
msgstr ""
"ਸੰਭਵ ਹੋਵੇ ਤਾਂ ਕਦੇ ਨਹੀਂ (ਸਭ ਤੋਂ ਤੇਜ਼, ਪਰ ਜ਼ਿਆਦਾਤਰ ਫਿਲਟਰਾਂ ਵੱਲੋਂ ਸਮਰਥਿਤ ਨਹੀਂ)"

msgctxt "IDS_PPAGE_CAPTURE_SFG1"
msgid "Only when switching different video types"
msgstr "ਸਿਰਫ਼ ਜਦੋਂ ਵੱਖ-ਵੱਖ ਵੀਡੀਓ ਕਿਸਮਾਂ ਵਿਚਕਾਰ ਬਦਲਿਆ ਜਾਵੇ"

msgctxt "IDS_PPAGE_CAPTURE_SFG2"
msgid "Always (may be required by some devices)"
msgstr "ਹਮੇਸ਼ਾਂ (ਕੁਝ ਡਿਵਾਈਸਾਂ ਲਈ ਲਾਜ਼ਮੀ ਹੋ ਸਕਦਾ ਹੈ)"

