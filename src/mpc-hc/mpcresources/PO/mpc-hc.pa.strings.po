msgctxt "IDS_MESSAGEBOX_CONTINUE"
msgid "&Continue"
msgstr "ਜਾਰੀ ਰੱਖੋ(&C)"

msgctxt "IDS_AG_TOGGLE_DEFAULT_SUBTITLE_STYLE"
msgid "Toggle Override Default Style"
msgstr "ਡਿਫਾਲਟ ਸਟਾਈਲ ਓਵਰਰਾਈਡ ਚਾਲੂ/ਬੰਦ ਕਰੋ"

msgctxt "IDS_PPAGEADVANCED_LOOP_FOLDER_NEXT_FILE"
msgid "Loop back to first file in folder after playing the last file."
msgstr "ਆਖਰੀ ਫਾਇਲ ਚੱਲਣ ਤੋਂ ਬਾਅਦ ਫੋਲਡਰ ਦੀ ਪਹਿਲੀ ਫਾਇਲ ‘ਤੇ ਮੁੜ ਲੂਪ ਕਰੋ।"

msgctxt "IDS_PPAGEADVANCED_FULLSCREEN_DELAY"
msgid "Delay before showing fullscreen video, to prevent visual glitches."
msgstr ""
"ਫੁੱਲ-ਸਕ੍ਰੀਨ ਵੀਡੀਓ ਦਿਖਾਉਣ ਤੋਂ ਪਹਿਲਾਂ ਡਿਲੇ ਰੱਖੋ, ਤਾਂ ਜੋ ਵਿਜੁਅਲ ਗਲਿਚਾਂ ਤੋਂ ਬਚਿਆ"
" ਜਾ ਸਕੇ।"

msgctxt "IDS_PPAGEADVANCED_SNAPSHOTSUBTITLES"
msgid "Render subtitles onto screenshots"
msgstr "ਸਕ੍ਰੀਨਸ਼ਾਟ ‘ਤੇ ਸਬਟਾਈਟਲ ਰੈਂਡਰ ਕਰੋ"

msgctxt "IDS_PPAGEADVANCED_SNAPSHOTKEEPVIDEOEXTENSION"
msgid ""
"Keep video file extension as part of snapshot filenames (e.g., file.mkv.png)"
msgstr ""
"ਸਨੈਪਸ਼ਾਟ ਫਾਈਲ ਨਾਂ ਵਿੱਚ ਵੀਡੀਓ ਫਾਈਲ ਐਕਸਟੈਂਸ਼ਨ ਨੂੰ ਰੱਖੋ (ਜਿਵੇਂ, file.mkv.png)"

msgctxt "IDS_PRESIZE_SHADERS_ENABLED"
msgid "Pre-Resize Pixel Shaders: on"
msgstr "ਪ੍ਰੀ-ਰੀਸਾਈਜ਼ ਪਿਕਸਲ ਸ਼ੇਡਰ: ਚਾਲੂ"

msgctxt "IDS_PRESIZE_SHADERS_DISABLED"
msgid "Pre-Resize Pixel Shaders: off"
msgstr "ਪ੍ਰੀ-ਰੀਸਾਈਜ਼ ਪਿਕਸਲ ਸ਼ੇਡਰ: ਬੰਦ"

msgctxt "IDS_PRESIZE_SHADERS_TOGGLE"
msgid "Enable Pre-Resize Pixel Shaders"
msgstr "ਪ੍ਰੀ-ਰੀਸਾਈਜ਼ ਪਿਕਸਲ ਸ਼ੇਡਰ ਚਾਲੂ ਕਰੋ"

msgctxt "IDS_POSTSIZE_SHADERS_ENABLED"
msgid "Post-Resize Pixel Shaders: on"
msgstr "ਪੋਸਟ-ਰੀਸਾਈਜ਼ ਪਿਕਸਲ ਸ਼ੇਡਰ: ਚਾਲੂ"

msgctxt "IDS_POSTSIZE_SHADERS_DISABLED"
msgid "Post-Resize Pixel Shaders: off"
msgstr "ਪੋਸਟ-ਰੀਸਾਈਜ਼ ਪਿਕਸਲ ਸ਼ੇਡਰ: ਬੰਦ"

msgctxt "IDS_POSTSIZE_SHADERS_TOGGLE"
msgid "Enable Post-Resize Pixel Shaders"
msgstr "ਪੋਸਟ-ਰੀਸਾਈਜ਼ ਪਿਕਸਲ ਸ਼ੇਡਰ ਸਮਰੱਥ ਕਰੋ"

msgctxt "IDS_PPAGEADVANCED_TIME_REFRESH_INTERVAL"
msgid "Refresh interval (in milliseconds) of time in status bar"
msgstr "ਸਟੇਟਸ ਬਾਰ ਵਿੱਚ ਸਮੇਂ ਦਾ ਰਿਫ੍ਰੈਸ਼ ਇੰਟਰਵਲ (ਮਿਲੀਸੈਕਿੰਡ ਵਿੱਚ)"

msgctxt "IDS_PPAGEADVANCED_SHOW_VOLUME_PERCENTAGE"
msgid "Show percentage value on volume slider (in modern theme)"
msgstr "ਵਾਲਿਊਮ ਸਲਾਈਡਰ ‘ਤੇ ਪ੍ਰਤੀਸ਼ਤ ਮੁੱਲ ਵੇਖਾਓ (ਮਾਡਰਨ ਥੀਮ ਵਿੱਚ)"

msgctxt "IDS_PPAGEADVANCED_SHOW_LANG_STATUSBAR"
msgid "Display current audio and subtitle language in status bar"
msgstr "ਸਟੇਟਸ ਬਾਰ ਵਿੱਚ ਮੌਜੂਦਾ ਆਡੀਓ ਅਤੇ ਸਬਟਾਈਟਲ ਭਾਸ਼ਾ ਵੇਖਾਓ"

msgctxt "IDS_PPAGEADVANCED_SHOW_FPS_STATUSBAR"
msgid "Display current fps and rate in status bar"
msgstr "ਸਟੇਟਸ ਬਾਰ ਵਿੱਚ ਮੌਜੂਦਾ fps ਅਤੇ ਰੇਟ ਵੇਖਾਓ"

msgctxt "IDS_PPAGEADVANCED_ADD_LANGCODE_WHEN_SAVE_SUBTITLES"
msgid ""
"When save the subtitles file, the language code (if available) text will be "
"added to suggested file name by default."
msgstr ""
"ਜਦੋਂ ਸਬਟਾਈਟਲ ਫਾਇਲ ਸੰਭਾਲੀ ਜਾਂਦੀ ਹੈ, ਤਾਂ ਭਾਸ਼ਾ ਕੋਡ (ਜੇ ਉਪਲਬਧ ਹੋਵੇ) ਮੂਲ ਰੂਪ "
"ਵਿੱਚ ਸੁਝਾਏ ਗਏ ਫਾਇਲ ਨਾਂ ਵਿੱਚ ਜੋੜ ਦਿੱਤਾ ਜਾਵੇਗਾ।"

msgctxt "IDS_PPAGEADVANCED_USE_TITLE_IN_RECENT_FILE_LIST"
msgid "Use title in recent file list."
msgstr "ਹਾਲ ਹੀ ਦੀਆਂ ਫਾਈਲਾਂ ਦੀ ਸੂਚੀ ਵਿੱਚ ਸਿਰਲੇਖ ਵਰਤੋ।"

msgctxt "IDS_PPAGEADVANCED_SHOW_ABMARKS_STATUSBAR"
msgid "Display current A-B repeat marks in status bar."
msgstr "ਸਟੇਟਸ ਬਾਰ ਵਿੱਚ ਮੌਜੂਦਾ A-B ਰਿਪੀਟ ਮਾਰਕ ਦਿਖਾਓ।"

msgctxt "IDS_PPAGEADVANCED_SHOW_VIDEOINFO_STATUSBAR"
msgid "Display video info (codec name, resolution) in status bar."
msgstr "ਸਟੇਟਸ ਬਾਰ ਵਿੱਚ ਵੀਡੀਓ ਜਾਣਕਾਰੀ (ਕੋਡੈਕ ਨਾਂ, ਰੈਜ਼ੋਲੂਸ਼ਨ) ਵੇਖਾਓ।"

msgctxt "IDS_PPAGEADVANCED_PAUSE_WHILE_DRAGGING_SEEKBAR"
msgid "Pause playback while dragging the seekbar."
msgstr "ਸੀਕਬਾਰ ਨੂੰ ਡ੍ਰੈਗ ਕਰਦੇ ਸਮੇਂ ਪਲੇਬੈਕ ਨੂੰ ਪੌਜ਼ ਕਰੋ।"

msgctxt "IDS_PPAGEADVANCED_CONFIRM_FILE_DELETE"
msgid "Show confirmation prompt before deleting file"
msgstr "ਫਾਇਲ ਮਿਟਾਉਣ ਤੋਂ ਪਹਿਲਾਂ ਪੁਸ਼ਟੀ ਪ੍ਰਾਂਪਟ ਦਿਖਾਓ"

msgctxt "IDS_PPAGEADVANCED_LIBASS_FOR_SRT"
msgid ""
"Use libass (instead of standard renderer) for SRT subtitles. NOT "
"recommended."
msgstr ""
"SRT ਸਬਟਾਈਟਲ ਲਈ ਸਟੈਂਡਰਡ ਰੈਂਡਰਰ ਦੀ ਬਜਾਏ libass ਵਰਤੋ। ਸਿਫਾਰਸ਼ ਨਹੀਂ ਕੀਤੀ ਜਾਂਦੀ।"

msgctxt "IDS_PPAGEADVANCED_OPEN_REC_PANEL_WHEN_OPENING_DEVICE"
msgid ""
"Show the recording settings dialog automatically when opening a device."
msgstr "ਡਿਵਾਈਸ ਖੋਲ੍ਹਣ ਵੇਲੇ ਰਿਕਾਰਡਿੰਗ ਸੈਟਿੰਗਾਂ ਵਾਲਾ ਡਾਇਲਾਗ ਆਪਣੇ ਆਪ ਦਿਖਾਓ।"

msgctxt "IDS_PPAGEADVANCED_ALWAYS_USE_SHORT_MENU"
msgid ""
"Player Menu shortcuts and right-click show compact menu -- even when main "
"menu is hidden."
msgstr ""
"ਪਲੇਅਰ ਮੀਨੂ ਸ਼ਾਰਟਕੱਟ ਅਤੇ ਸੱਜਾ-ਕਲਿੱਕ ਸੰਕੁਚਿਤ ਮੀਨੂ ਦਿਖਾਉਂਦੇ ਹਨ — ਭਾਵੇਂ ਮੁੱਖ ਮੀਨੂ"
" ਲੁਕਿਆ ਹੋਇਆ ਹੋਵੇ।"

msgctxt "IDS_PPAGEADVANCED_FULLSCREEN_SEPARATE_CONTROLS"
msgid ""
"Keep main window controls visible on current monitor when going fullscreen "
"on another monitor."
msgstr ""
"ਜਦੋਂ ਕਿਸੇ ਹੋਰ ਮਾਨੀਟਰ ‘ਤੇ ਫੁੱਲ-ਸਕ੍ਰੀਨ ਕੀਤਾ ਜਾਵੇ, ਤਾਂ ਮੁੱਖ ਵਿੰਡੋ ਦੇ ਕੰਟਰੋਲ "
"ਮੌਜੂਦਾ ਮਾਨੀਟਰ ‘ਤੇ ਹੀ ਵਿਖਾਈ ਰੱਖੋ।"

msgctxt "IDS_PPAGEADVANCED_BLOCKRDP"
msgid "Block use of RDP Redirection Filter"
msgstr "RDP ਰੀਡਾਇਰੈਕਸ਼ਨ ਫਿਲਟਰ ਦੀ ਵਰਤੋਂ ਰੋਕੋ"

msgctxt "IDS_PPAGEADVANCED_YDL_EXEPATH"
msgid ""
"Full path of the yt-dlp (or youtube-dl) executable.\n"
"Just the filename is enough in case it is located in same folder as MPC-HC.\n"
"Leave empty to use default filename: yt-dlp.exe"
msgstr ""
"yt-dlp (ਜਾਂ youtube-dl) ਐਗਜ਼ਿਕਿਊਟੇਬਲ ਦਾ ਪੂਰਾ ਪਾਥ।\n"
"ਜੇ ਇਹ MPC-HC ਵਾਲੇ ਹੀ ਫੋਲਡਰ ਵਿੱਚ ਹੋਵੇ ਤਾਂ ਸਿਰਫ਼ ਫਾਈਲ ਨਾਂ ਹੀ ਕਾਫ਼ੀ ਹੈ।\n"
"ਡਿਫਾਲਟ ਫਾਈਲ ਨਾਂ ਵਰਤਣ ਲਈ ਖਾਲੀ ਛੱਡੋ: yt-dlp.exe"

msgctxt "IDS_PPAGEADVANCED_YDL_SUBS_PREFERENCE"
msgid ""
"The language preference for loading subtitle streams extracted by Youtube-DL.\n"
"If empty, no subtitles are loaded.\n"
"Use ISO639-1 two letter language code(s).\n"
"Example: en de es pl zh ja nl"
msgstr ""
"Youtube-DL ਵੱਲੋਂ ਕੱਢੀਆਂ ਗਈਆਂ subtitle streams ਨੂੰ ਲੋਡ ਕਰਨ ਲਈ ਭਾਸ਼ਾ ਤਰਜੀਹ।\n"
"ਜੇ ਖਾਲੀ ਹੋਵੇ ਤਾਂ ਕੋਈ subtitles ਲੋਡ ਨਹੀਂ ਕੀਤੀਆਂ ਜਾਣਗੀਆਂ।\n"
"ISO639-1 ਦੀ ਦੋ ਅੱਖਰੀ ਭਾਸ਼ਾ ਕੋਡ ਵਰਤੋ।\n"
"ਉਦਾਹਰਨ: en de es pl zh ja nl"

msgctxt "IDS_PPAGEADVANCED_USE_AUTOMATIC_CAPTIONS"
msgid ""
"Use automatic generated captions from Youtube. Note: this can cause a small "
"delay when loading the stream."
msgstr ""
"Youtube ਤੋਂ ਆਟੋਮੈਟਿਕ ਤੌਰ ‘ਤੇ ਬਣੀਆਂ ਕੈਪਸ਼ਨ ਵਰਤੋ। ਨੋਟ: ਇਸ ਨਾਲ ਸਟ੍ਰੀਮ ਲੋਡ ਹੋਣ "
"ਵੇਲੇ ਥੋੜ੍ਹੀ ਦੇਰੀ ਹੋ ਸਕਦੀ ਹੈ।"

msgctxt "IDS_PPAGEADVANCED_USE_SMTC"
msgid ""
"Allow control of the player through System Media Transport Controls in "
"Windows 8.1/10/11."
msgstr ""
"Windows 8.1/10/11 ਵਿੱਚ System Media Transport Controls ਰਾਹੀਂ ਪਲੇਅਰ ਦਾ ਕੰਟਰੋਲ"
" ਮਨਜ਼ੂਰ ਕਰੋ।"

msgctxt "IDS_PPAGEADVANCED_LOCK_NOPAUSE"
msgid "Do not pause playback when locking the screen."
msgstr "ਸਕ੍ਰੀਨ ਲੌਕ ਕਰਨ ਵੇਲੇ ਪਲੇਬੈਕ ਨੂੰ ਪੌਜ਼ ਨਾ ਕਰੋ।"

msgctxt "IDS_PPAGEADVANCED_RELOAD_AFTER_LONG_PAUSE"
msgid ""
"Reload video file before resuming playback if it was paused for more than X "
"minutes. Use 0 to disable automatic file reload after pause. Use -1 to also "
"disable reload after hibernate/sleep."
msgstr ""
"ਜੇ ਪਲੇਬੈਕ X ਮਿੰਟ ਤੋਂ ਵੱਧ ਸਮੇਂ ਲਈ ਪੌਜ਼ ਰਿਹਾ ਹੋਵੇ, ਤਾਂ ਮੁੜ ਚਲਾਉਣ ਤੋਂ ਪਹਿਲਾਂ "
"ਵੀਡੀਓ ਫਾਇਲ ਨੂੰ ਰੀਲੋਡ ਕਰੋ। ਪੌਜ਼ ਤੋਂ ਬਾਅਦ ਆਟੋਮੈਟਿਕ ਫਾਇਲ ਰੀਲੋਡ ਅਣਐਨੇਬਲ ਕਰਨ ਲਈ 0"
" ਵਰਤੋ। ਹਾਈਬਰਨੇਟ/ਸਲੀਪ ਤੋਂ ਬਾਅਦ ਰੀਲੋਡ ਵੀ ਅਣਐਨੇਬਲ ਕਰਨ ਲਈ -1 ਵਰਤੋ।"

msgctxt "IDS_PPAGEADVANCED_REDIRECT_OPEN_TO_APPEND_THRESHOLD"
msgid ""
"If a file is opened within this amount of milliseconds after a previous "
"file, then it will be appended to playlist instead of replacing that "
"previous file. This redirection is required for properly handling opening of"
" a selection of files in Explorer. A too short threshold can result in only "
"a part of your selection being added to playlist."
msgstr ""
"ਜੇਕਰ ਕੋਈ ਫਾਇਲ ਪਿਛਲੀ ਫਾਇਲ ਤੋਂ ਇਸ ਗਿਣਤੀ ਮਿਲੀਸੈਕਿੰਡਾਂ ਦੇ ਅੰਦਰ ਖੋਲ੍ਹੀ ਜਾਂਦੀ ਹੈ, "
"ਤਾਂ ਉਹ ਪਿਛਲੀ ਫਾਇਲ ਨੂੰ ਰਿਪਲੇਸ ਕਰਨ ਦੀ ਬਜਾਏ ਪਲੇਲਿਸਟ ਵਿੱਚ ਐਪੈਂਡ ਕਰ ਦਿੱਤੀ ਜਾਵੇਗੀ।"
" ਇਹ ਰੀਡਾਇਰੈਕਸ਼ਨ Explorer ਵਿੱਚ ਫਾਇਲਾਂ ਦੀ ਚੋਣ ਖੋਲ੍ਹਣ ਨੂੰ ਠੀਕ ਤਰੀਕੇ ਨਾਲ ਹੈਂਡਲ "
"ਕਰਨ ਲਈ ਲੋੜੀਂਦੀ ਹੈ। ਬਹੁਤ ਘੱਟ ਥ੍ਰੈਸ਼ਹੋਲਡ ਕਾਰਨ ਤੁਹਾਡੀ ਚੋਣ ਦਾ ਸਿਰਫ਼ ਕੁਝ ਹਿੱਸਾ ਹੀ "
"ਪਲੇਲਿਸਟ ਵਿੱਚ ਸ਼ਾਮਲ ਹੋ ਸਕਦਾ ਹੈ।"

